{
  "name": "akibwa-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-shelf.mjs --dev && next dev",
    "check:fast": "npm run build && node scripts/check-navigation-dom.mjs --shelf",
    "check:release": "npm run check:fast",
    "check:hosting": "node scripts/check-cloudflare-hosting.mjs",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc",
    "check:navigation": "node scripts/check-navigation-contract.mjs && node scripts/check-album-catalogue.mjs && node scripts/check-listening-counts.mjs && node scripts/check-music-room-data.mjs && node --test scripts/music-ranking.test.mjs",
    "check:navigation:dom": "node scripts/check-navigation-dom.mjs",
    "check:worker": "node --test scripts/service-worker.test.mjs",
    "build": "npm run check:navigation && node scripts/build-shelf.mjs && NEXT_TELEMETRY_DISABLED=1 next build && cp -R .shelf-build/sleeves out/_next/static/",
    "publish:check": "node scripts/check-publication.mjs",
    "publish:ready": "npm run check:fast && npm run albums:art:check && npm run publish:check",
    "start": "next start",
    "albums:art": "node scripts/build-album-art.mjs",
    "music:refresh": "node scripts/refresh-music.mjs",
    "albums:art:check": "node scripts/build-album-art.mjs --check && node scripts/build-listening-artwork.mjs --check",
    "albums:catalogue-art": "node scripts/build-listening-artwork.mjs",
    "albums:catalogue-art:check": "node scripts/build-listening-artwork.mjs --check",
    "albums:lastfm-art": "node scripts/fetch-lastfm-art.mjs",
    "listening:build": "node scripts/build-listening-counts.mjs"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "wrangler": "4.165.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "$sharp"
  }
}
